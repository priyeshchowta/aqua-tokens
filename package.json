{
  "name": "aqua-tokens",
  "version": "0.1.0-beta",
  "description": "Local-first CLI that tracks available Claude Code usage data and converts counted request tokens into an estimated water-footprint range",
  "type": "module",
  "bin": {
    "aqua-tokens": "./dist/cli.js"
  },
  "files": [
    "dist",
    "water-methodology.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm test && npm run build",
    "otel-poc": "tsx src/otel-poc.ts"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "cli",
    "tokens",
    "water",
    "claude-code",
    "anthropic",
    "opentelemetry"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyeshchowta/aqua-tokens.git"
  },
  "bugs": {
    "url": "https://github.com/priyeshchowta/aqua-tokens/issues"
  },
  "homepage": "https://github.com/priyeshchowta/aqua-tokens#readme",
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
